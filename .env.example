# Synapse Pipeline Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real credentials

# ===== REQUIRED CONFIGURATION =====

# Claude API (REQUIRED for digest generation)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram API credentials (REQUIRED for data export)
# Get these from: https://my.telegram.org/apps
SYNAPSE_TELEGRAM__API_ID=
SYNAPSE_TELEGRAM__API_HASH=

# Telegram session string (REQUIRED after initial setup)
# Generated using: synapse-pipeline doctor generate-session
SYNAPSE_TELEGRAM__SESSION_STRING=

# ===== OPTIONAL CONFIGURATION =====

# Telegram Bot Token (OPTIONAL - only needed for notifications)
# Create a bot using @BotFather on Telegram
# See docs/telegram-bot-setup.md for detailed instructions
SYNAPSE_TELEGRAM_NOTIFIER__BOT_TOKEN=

# Google Drive configuration is in config.toml
# Only override here if you need environment-specific settings
# SYNAPSE_GDRIVE__SERVICE_ACCOUNT_PATH=./service-account.json
# SYNAPSE_GDRIVE__TEAM_DATA_FOLDER_ID=
# SYNAPSE_GDRIVE__TEAM_DIGESTS_FOLDER_ID=
