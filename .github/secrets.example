# GitHub Actions Secrets Template
# Copy this to your GitHub repository secrets
# Do NOT commit actual values to the repository!

# Required for MVP (Phase 1)
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required for Full Pipeline (Phase 2)

# Telegram Export (Workstream 1)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=***REMOVED***
TELEGRAM_SESSION_STRING=1BVtsOLsBu...  # Generated using telethon StringSession
TELEGRAM_CHANNEL_IDS=channel_id_1,channel_id_2,channel_id_3

# Google Drive Service Account (Workstream 2)
# Generate at: https://console.cloud.google.com/apis/credentials
GDRIVE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"***REMOVED***\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Telegram Bot Notifications (Workstream 4)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890